# NEXORA ONE — variables de déploiement (finalisation phase 18). Copier en « production.env » (ignoré par Git).
# Aucun secret ici : ils sont dans infrastructure/secrets/ (scripts/generate-secrets.sh).

# Domaine public servi en HTTPS (certificat Let's Encrypt automatique) et adresse des avis d'expiration.
NEXORA_DOMAIN=app.exemple.ht
NEXORA_ACME_EMAIL=exploitation@exemple.ht

# Images : registre et version déployée (tag Git sans « v », ex. 1.4.0). La version figure dans Exploitation → Production.
NEXORA_REGISTRY=ghcr.io/votre-organisation
NEXORA_VERSION=1.0.0
NEXORA_COMMIT=

NEXORA_TIMEZONE=America/Port-au-Prince
NEXORA_SESSION_MAX_HOURS=12

# Sauvegardes : dossier de l'hôte (à répliquer hors site), rétention, heure UTC du passage quotidien.
NEXORA_BACKUP_HOST_DIR=/srv/nexora/backups
NEXORA_BACKUP_RETENTION_DAYS=14
NEXORA_BACKUP_HOUR_UTC=6

# Traces et métriques : collecteur du profil « observability » (laisser vide pour désactiver).
NEXORA_OTLP_ENDPOINT=http://otel-collector:4317

# E-mail (mot de passe oublié, alertes). Le mot de passe SMTP est un secret : fichier secrets/smtp_password.
NEXORA_SMTP_ENABLED=false
NEXORA_SMTP_HOST=
NEXORA_SMTP_PORT=587
NEXORA_SMTP_SSL=true
NEXORA_SMTP_USER=
NEXORA_SMTP_FROM=Nexora One <no-reply@exemple.ht>
