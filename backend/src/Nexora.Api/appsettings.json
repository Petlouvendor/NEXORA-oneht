{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "",
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "nexora",
    "Audience": "nexora-api",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Scheduler": {
    "Enabled": false,
    "IntervalSeconds": 60
  },
  "Notifications": {
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": false,
      "UserName": "",
      "Password": "",
      "FromAddress": ""
    },
    "Twilio": {
      "Enabled": false,
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    },
    "Fcm": {
      "Enabled": false,
      "ServiceAccountJson": ""
    }
  },
  "AllowedHosts": "*"
}
